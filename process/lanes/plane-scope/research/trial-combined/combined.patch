@@ -0,0 +1,13 @@
+/* TRIAL (door inversion): control-plane's harness with the interface plugged in, for the suites that ask the door for a page, the
+   shell's script or an asset. It is `harness.mjs` whole, but `makeFetch`, `defaultHooks` and `call` hand the door the interface the
+   program's entry hands it (`src/plane/ui.mjs`, a file above the interface). A hook set that names its own `ui` keeps it.
+   The interface is imported after the harness has loaded, never beside it: two screen modules read the op tables when they load, and
+   the harness's registration of the declared ops (`register-declared.mjs`, which awaits) must come first. */
+export * from "./harness.mjs";
+import { makeFetch as bareMakeFetch, defaultHooks as bareHooks, call as bareCall } from "./harness.mjs";
+const { INTERFACE } = await import("../../../src/plane/ui.mjs");
+
+export { INTERFACE };
+export const makeFetch = (hooks = {}) => bareMakeFetch({ ui: INTERFACE, ...hooks });
+export const defaultHooks = (log) => ({ ...bareHooks(log), ui: INTERFACE });
+export const call = (env, o = {}) => bareCall(env, { ...o, hooks: { ui: INTERFACE, ...(o.hooks ?? bareHooks()) } });
