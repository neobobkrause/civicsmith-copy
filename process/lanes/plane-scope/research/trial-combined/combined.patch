+/* TRIAL (door inversion): THE INTERFACE, ASSEMBLED FOR THE DOOR. The one file that imports the interface's modules
+   (interface-shell, interface-assets, the nine screen modules) for the program: what `control-plane`'s door took
+   by import before the trial (ties T01 to T17 and N02 of research file 11), composed here and handed down by `index.mjs`.
+   Owned by the trial's top module, not by `plane`. */
+import { interfacePage, interfaceScript, interfaceScriptHash, pageWork, versionOfScriptPath, PUBLIC_ADDRESSES } from "../interface-shell/index.mjs";
+import { ASSET_FILES } from "../interface-assets/index.mjs";
+import { SCREENS as ENTRY_SCREENS } from "../screens-entry/index.mjs";
+import { SCREENS as SETTINGS_SCREENS } from "../screens-settings/index.mjs";
+import { SCREENS as INTAKE_SCREENS } from "../screens-intake/index.mjs";
+import { SCREENS as DAILY_SCREENS } from "../screens-daily/index.mjs";
+import { SCREENS as INQUIRY_SCREENS } from "../screens-inquiry/index.mjs";
+import { SCREENS as WIZARDS_SCREENS, GUIDE as WIZARD_GUIDE } from "../screens-wizards/index.mjs";
+import { SCREENS as INVESTIGATE_SCREENS } from "../screens-investigate/index.mjs";
+import { SCREENS as PUBLISH_SCREENS } from "../screens-publish/index.mjs";
+import { SCREENS as ACTION_SCREENS } from "../screens-action/index.mjs";
+
+/* control-plane R81's order, as the door spread them before the trial */
+const APP_SCREENS = Object.freeze([...ENTRY_SCREENS, ...SETTINGS_SCREENS, ...INTAKE_SCREENS, ...DAILY_SCREENS, ...INQUIRY_SCREENS,
+  ...WIZARDS_SCREENS, ...INVESTIGATE_SCREENS, ...PUBLISH_SCREENS, ...ACTION_SCREENS]);
+
+/** The door's `hooks.ui`: the shell's builders and its parser of its script address, the asset table, the screens in one list, the
+ *  guide, and the shell's public addresses as paths (`/doorbell`, `/tour`). */
+export const INTERFACE = Object.freeze({
+  interfacePage, interfaceScript, interfaceScriptHash, pageWork, versionOfScriptPath,
+  assets: ASSET_FILES, screens: APP_SCREENS, guide: WIZARD_GUIDE,
+  publicAddresses: Object.freeze(Object.keys(PUBLIC_ADDRESSES).map((name) => `/${name}`)),
+});
+
