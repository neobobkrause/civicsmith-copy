@@ -0,0 +1,22 @@
+/* control-plane's real door over a real store, in plain node (a scratch trial, plane-scope research 23; after research 22b's `real-door.mjs`). The door is this module's own
+   `makeFetch`, handed THE REAL ARM ROUTING (`publicOp`, `gatedOp`), imported from where the trial puts it, so an op a module's arm answers (`acquire`, `knock`, `casedocument`,
+   `caseratify`, ...) is answered by the product's own composition and no copy of it is made here. The store behind the door is store-request's world (`storeWorld`: store-assembly's
+   `assembleStore` over node:sqlite, memory buckets, a pinned clock); every request the door or an arm makes to the object is passed to `world.send`. Built only from control-plane
+   and modules before it: nothing of plane is loaded. `publicInstanceGroup`, the third hook plane hands the door, is not handed here (no test over this file asks it). */
+import { storeWorld } from "../store-request/fixtures.mjs";
+import { memoryBucket } from "../store-assembly/world.mjs";
+import { makeFetch } from "../../../src/control-plane/index.mjs";
+import { publicOp, gatedOp } from "../../../src/control-plane/routing.mjs";
+
+const ORIGIN = "https://group.example";
+
+/** `realDoor(opts)` → `{world, env, door, plane(url, init)}`: `opts` are `storeWorld`'s. The world's own `env` is the door's, with `STORE.get` answering a stub over `world.send`
+ *  and both buckets bound, as an installation that publishes has them; `plane(url, init)` asks the door as `Miniflare#dispatchFetch` asks the Worker, and answers its Response. */
+export async function realDoor(opts = {}) {
+  const world = await storeWorld({ ...opts, env: { PUBLISHED: memoryBucket(), ...(opts.env || {}) } });
+  const stub = { fetch: async (input, init) => world.send(input instanceof Request ? input : new Request(String(input), init)) };
+  world.env.STORE = { idFromName: (n) => n, get: () => stub };
+  const door = makeFetch({ publicOp, gatedOp });
+  const plane = (url, init = {}) => door(new Request(new URL(url, ORIGIN).href, init), world.env);
+  return { world, env: world.env, door, plane };
+}
