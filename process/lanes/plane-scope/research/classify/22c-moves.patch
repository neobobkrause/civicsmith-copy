diff --git a/bio-plane/test/m/screens-intake/realworld.mjs b/bio-plane/test/m/screens-intake/realworld.mjs
new file mode 100644
index 0000000000..9d081cb221
--- /dev/null
+++ b/bio-plane/test/m/screens-intake/realworld.mjs
@@ -0,0 +1,60 @@
+/* The REAL store behind the served `capture` page, for this module's fix-round-10 tests that were plane's (`realplane.mjs`, Miniflare over plane's
+ * entry). Here the store is store-request's world (`storeWorld`: store-assembly's `assembleStore` over node:sqlite, the world's door running the real
+ * admission and store request), so nothing later than screens-intake is loaded (K4990: every answer is the provider's own code; nothing is built by hand).
+ * The API is `realplane.mjs`'s: `founder()`, `uploaded(auth, recipe, name, edit)`, `ticksUntil(p, drawn)`, `deferred`, `dispose()`. The store's own jobs
+ * run on the world's alarm (`world.tick`), which `ticksUntil` moves with the page's clock. */
+import { generate } from "../../corpus.mjs";
+import { members, openWorld, fill, press, idle } from "./page.mjs";
+
+/* every op the capture screen's flows reach on the way from an upload to its reading, as `realplane.mjs` lists them */
+const OPS = ["captureupload", "allocid", "promote", "heldat", "heldcaptures", "opencaptures", "capturerequests", "reading", "readheld", "search", "projectlist",
+  "image", "memberlist", "captureseenin", "select", "release", "heldsetaside", "heldrestore"];
+
+export function realWorld() {
+  let made = null;
+  const t = () => made ||= members({ mai: ["contribute", "create_projects"] });
+
+  /* the signed-in member stands where the founder's session stood: the page's door adds her sign-in */
+  async function founder() { return (await t()).mai; }
+
+  /* the page's table: an op a test names an edit for is asked of the world's door and its real answer edited by name; every other op the door answers */
+  function viaDoor(world, as, edit = {}) {
+    return Object.fromEntries(OPS.filter((op) => edit[op]).map((op) => [op, async (req) => {
+      const a = await world.door(req, as);
+      return { ...a, json: edit[op](a.json) };
+    }]));
+  }
+
+  /* the upload answer given `reading_pending: true` and no reading of its own (realplane.mjs's one named edit) */
+  const deferred = (json) => {
+    if (!json || !json.result) return json;
+    const { reading: _r, text_units: _u, completeness: _c, ...answer } = json.result;
+    const { reading: _dr, text_units: _du, ...document } = answer.document || {};
+    return { ...json, result: { ...answer, ...(answer.document ? { document } : {}), reading_pending: true } };
+  };
+
+  async function uploaded(as, recipe, name, edit = {}) {
+    const { world } = await t();
+    const f = generate(recipe), bytes = Buffer.from(await f.bytes());
+    const p = await openWorld("/app/capture/file", { world, as, plane: viaDoor(world, as, { captureupload: deferred, ...edit }) });
+    fill(p, { "ci-file": new File([bytes], name, { type: f.type }), "ci-how-made": true, "ci-where": "City hall", "ci-what": "The scan." });
+    await press(p, "captureupload");
+    await p.clock.tick(1);
+    await idle(p, 3000);
+    return p;
+  }
+
+  /* the page's clock and the world's alarm are moved thirty seconds at a time until what the test waits for is drawn: a bound of counts, never a time (R66) */
+  async function ticksUntil(p, drawn, steps = 20) {
+    const { world } = await t();
+    for (let i = 0; i < steps && !drawn(); i++) {
+      const by = i === 0 ? 21000 : 30000;
+      await world.tick(by);
+      await p.clock.tick(by);
+      await idle(p, 3000);
+    }
+    return drawn();
+  }
+
+  return { founder, viaDoor, deferred, uploaded, ticksUntil, dispose: () => {} };
+}
