diff --git a/bio-plane/test/m/store-assembly/r10-nohome-refiled.test.mjs b/bio-plane/test/m/store-assembly/r10-nohome-refiled.test.mjs
new file mode 100644
index 0000000000..cf92d67eb2
--- /dev/null
+++ b/bio-plane/test/m/store-assembly/r10-nohome-refiled.test.mjs
@@ -0,0 +1,55 @@
+/* store-assembly R59, R74 (was plane R25, R97; fix round 10, G5; walk D2a; K5057), the store's half of plane's `r10-nohome-filed-later.test.mjs`, over the assembled
+   store on the suite's storage (`alarmed-store.mjs`), no plane and no door: an unfiled upload's `reading` row, registered as the door registers it (`pendingadd`), is
+   answered NO_HOME by the real reading owner at the alarm's tick and waits, backed off; once the document is filed (promotion's real `promote`), the registration the
+   door makes when it follows a filed document's reading (control-plane R123, proven at control-plane: `r123-reading.test.mjs`) brings the row forward, before its
+   backoff, and the next tick reads it. Counts and the store's own instants only (R-CLOCK). Scratch reconstruction for the plane-scope lane. */
+import "../../../src/store-assembly/register.mjs";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { store } from "./alarmed-store.mjs";
+import { multipartBucket } from "../record-core/storage.mjs";
+import { captureOf } from "../../../src/capture/index.mjs";
+import { promotionOf } from "../../../src/promotion/index.mjs";
+import { recordOf } from "../../../src/record-core/index.mjs";
+import { pendingOf } from "../../../src/store-assembly/pending.mjs";
+
+const hex = (b) => createHash("sha256").update(b).digest("hex");
+const NOW = "2026-10-22T00:00:00Z";
+const textBytes = (bytes) => { const n = Math.floor((bytes - 60) / 100), p = []; for (let i = 0; i < n; i++) p.push(`line ${String(i).padStart(6, "0")} ` + "council-minutes ".repeat(5).padEnd(87, ".") + "\n"); p.push("ENDMARKER" + " ".repeat(bytes - n * 100 - 9)); return Buffer.from(p.join("")); };
+
+test("R59 R74 (was plane R25 R97): an unfiled upload's reading waits NO_HOME backed off; filing it and the door's registration bring the row forward before that backoff, and it is read", { timeout: 300_000 }, async () => {
+  const x = await store({ env: { CAPTURES: multipartBucket(), INSTANCE_NAME: "town" } });
+  const ctx = x.ctx;
+  const up = await captureOf(ctx).uploadCapture({ bytes: textBytes(400_060), statement: "the clerk's file", name: "minutes.txt", type: "text/plain", by: "member:ann", boundMs: 1 });
+  assert.equal(up && up.ok, true, JSON.stringify(up).slice(0, 300));
+  const sha = up.capture.sha256, document = up.document;
+  const add = async () => (await x.fetch(`/pendingadd?kind=reading&sha=${sha}&store=bio`, { method: "POST" })).json();
+  assert.equal((await add()).ok, true);
+  const row = () => pendingOf(ctx).list().find((e) => e.kind === "reading" && e.sha === sha);
+  let at = Date.now() + 1000;
+  await x.s.onAlarm(at);
+  const waiting = row();
+  assert.ok(waiting && waiting.why === "NO_HOME" && Number(waiting.next_try) > at, `the first pass found no home and the row waits, backed off: ${JSON.stringify(waiting)}`);
+  const backoff = Number(waiting && waiting.next_try);
+  /* the filing: an information document whose file is the capture, through promotion's own commit */
+  const id = recordOf(ctx).allocId("INFO", "2026").id, title = document.file;
+  const md = ["---", "id: " + id, "object_type: information", "schema: information@2", "title: " + JSON.stringify(title), "current_state: collected", "prior_state: null", "created: " + NOW, "last_updated: " + NOW,
+    "produced_by:", "  mode: assisted", "  capability_tier: session", "references: []", "state_history: []", "annotations_open: 0", "reeval_pending:", "  flag: false", "  since: null", "  source: null", "visuals: []",
+    "criticality: supporting", "source_status: unchanged", "content_hash: sha256:" + hex(title), "source:", "  locator: " + JSON.stringify(document.locator), "  authority: member-entered", "  retrieved: " + NOW,
+    "monitoring:", "  enabled: false", "  frequency: none", "---", "", "## Summary", "", title, "", "## Provenance Notes", "", "## Session Log", "", "## Review Notes", ""].join("\n");
+  const prov = JSON.stringify({ documents: [document] }, null, 1), dataset = JSON.stringify({ documents: [{ bytes: up.capture.bytes, locator: document.locator, sha256: sha }] });
+  const len = (t) => Buffer.byteLength(t);
+  const pr = promotionOf(ctx).promote({ bundleId: id, base: null, snapKey: "20261022T000000_" + hex(id).slice(0, 8), meta: { object_type: "information", title, current_state: "collected", created: NOW, last_updated: NOW },
+    files: [{ path: "bundle.md", text: md, bytes: len(md), sha256: hex(md) }, { path: "data/provenance.json", text: prov, bytes: len(prov), sha256: hex(prov) },
+            { path: "data/dataset.json", text: dataset, bytes: len(dataset), sha256: hex(dataset) }, { path: document.file, blobSha: sha, sha256: sha, bytes: up.capture.bytes }],
+    register: [{ sha256: sha, path: document.file, encoding: "binary", bytes: up.capture.bytes }], author: "ann", actorMemberId: "ann", actorIdentity: "member:ann", actorViewer: "member:ann" });
+  assert.ok(pr && pr.ok !== false, JSON.stringify(pr).slice(0, 300));
+  assert.equal((await add()).ok, true, "the door's registration of the filed document's reading");
+  const after = row();
+  assert.ok(!after || Number(after.next_try) < backoff, `brought forward: ${JSON.stringify(after)} against ${backoff}`);
+  at = Math.max(at + 1, Date.now()) + 1000;
+  for (let i = 0; i < 20 && row(); i++) { await x.s.onAlarm(at); at += 1000; }
+  assert.equal(row(), undefined, `read before the backoff ${backoff} was due: ${JSON.stringify(row())}`);
+  assert.ok(at < backoff, `the reading ended at ${at}, before the backoff ${backoff}`);
+});
