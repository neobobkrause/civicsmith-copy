diff --git a/bio-plane/test/m/control-plane/real-door.mjs b/bio-plane/test/m/control-plane/real-door.mjs
new file mode 100644
index 0000000000..ed8c310d1d
--- /dev/null
+++ b/bio-plane/test/m/control-plane/real-door.mjs
@@ -0,0 +1,32 @@
+/* control-plane's real door over a real store, in plain node (scratch experiment, plane-scope research 22b). The door is this module's own `makeFetch`,
+   handed no hooks (every op takes the door's generic forward, as `r137-parity.test.mjs` drives it); the store behind it is store-request's world
+   (`storeWorld`: store-assembly's `assembleStore` over node:sqlite, a memory bucket, a pinned clock), every inner request the door makes passed to
+   `world.send`. Built only from modules before control-plane: nothing of plane is loaded. The ops plane's `door.mjs` answers by an arm of its own
+   (`acquire`, `capture`, the extraction and ratification arms, ...) are not composed here, so a test that needs one cannot use this as it stands. */
+import { storeWorld } from "../store-request/fixtures.mjs";
+import { makeFetch } from "../../../src/control-plane/index.mjs";
+
+const ORIGIN = "https://group.example";
+
+/** `realDoor(opts)` → `{world, env, ask(as, op, {method, query, body}), R}`: `as` is a signed-in member from `world.signIn` (her token is sent as the
+ *  bearer credential) or null for none; `ask` answers `{status, headers, body}` with the body parsed as JSON where it is JSON. */
+export async function realDoor(opts = {}) {
+  const world = await storeWorld(opts);
+  const stub = { fetch: async (input, init) => world.send(input instanceof Request ? input : new Request(String(input), init)) };
+  const env = { ...world.env, STORE: { idFromName: (n) => n, get: () => stub } };
+  const fetch = makeFetch({});
+  async function ask(as, op, { method, query = {}, body } = {}) {
+    const u = new URL("/api/", ORIGIN);
+    u.searchParams.set("op", op);
+    for (const [k, v] of Object.entries(query)) u.searchParams.set(k, v);
+    const m = method ?? (body === undefined ? "GET" : "POST");
+    const headers = { ...(as && as.token ? { authorization: `Bearer ${as.token}` } : {}), ...(body === undefined ? {} : { "content-type": "application/json" }) };
+    const res = await fetch(new Request(u, { method: m, headers, ...(body === undefined ? {} : { body: JSON.stringify(body) }) }), env);
+    const text = await res.text();
+    let parsed = null;
+    try { parsed = JSON.parse(text); } catch { parsed = text; }
+    return { status: res.status, headers: res.headers, body: parsed };
+  }
+  const R = (a) => (a && a.result !== undefined ? a.result : a);
+  return { world, env, ask, R };
+}
