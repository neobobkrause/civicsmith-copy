--- /dev/null
+++ b/bio-plane/test/m/control-plane/door-object-entry.mjs
@@ -0,0 +1,23 @@
+/* control-plane (scratch experiment, plane-scope research 22b): a test-only Worker for this module's tests that need the real runtime, booted under Miniflare.
+   Its default export is this module's own door, `makeFetch({})` (every op on the door's generic forward, no arm composed); its Durable Object class is the
+   store `store-assembly`'s `assembleStore` builds (with this module's `deliverOwedRender`, as the store is built for the product), every request passed to the
+   assembled store's one frame (`dispatch`). The platform's alarm is forwarded to the scheduler (workerd refuses the store's alarm without a handler: tried); `scheduler` is added to control-plane's
+   declared `uses` for it (scratch). Built only from modules before control-plane and from
+   control-plane itself: nothing of plane is imported. */
+import { DurableObject } from "cloudflare:workers";
+import { assembleStore } from "../../../src/store-assembly/index.mjs";
+import { schedulerOf } from "../../../src/scheduler/index.mjs";
+import { makeFetch, deliverOwedRender } from "../../../src/control-plane/index.mjs";
+
+export class Store extends DurableObject {
+  #assembled;
+  constructor(ctx, env) {
+    super(ctx, env);
+    this.ctx = ctx; this.env = env;
+    this.#assembled = assembleStore(ctx, env, { deliver: deliverOwedRender });
+  }
+  async alarm() { await schedulerOf(this.ctx, this.env).alarm(); }
+  async fetch(req) { return this.#assembled.dispatch(req); }
+}
+
+export default { fetch: makeFetch({}) };
