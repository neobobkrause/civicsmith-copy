{
  "process": { "repository": "https://github.com/neobobkrause/process4", "version": "4.0.0", "commit": "4614f8fdf44edd7ddb2c8c22c8301f30c37c9192" },
  "tranche_branch": "p4-tranche",
  "node": "26.10.0",
  "lock_files": [
    "agent-runner/package-lock.json",
    "bio-plane/package-lock.json",
    "bio-plane/src/journey-check/package-lock.json",
    "file-scanner/package-lock.json",
    "newgroup/package-lock.json",
    "ocr-worker/package-lock.json",
    "pdf-worker/package-lock.json",
    "sheet-worker/package-lock.json",
    "site/package-lock.json"
  ],
  "test_command": "node --import ./bio-plane/test/platform-sqlite.mjs --test",
  "slots": { "default": 8, "share": 8 },
  "lanes": [ { "name": "ux", "folder": "process/lanes/ux/" } ],
