  "process_folder": "process/",
  "language_reader": { "name": "typescript", "version": "5.6.3", "source": ["**/*.mjs"], "exclude": ["**/vendor/**", "**/dist/**", "release/**", "newgroup/src/release.mjs", "bio-plane/src/case-checker/program.mjs"] }
